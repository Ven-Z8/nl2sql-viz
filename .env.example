# NL2SQL Viz — Environment Variables
# Copy to .env and fill in real values

# Required: OpenRouter API key (get from https://openrouter.ai/keys)
# All LLM calls route through OpenRouter via litellm.
OPENROUTER_API_KEY=sk-or-...

# Optional: override the models used by the agents (OpenRouter slugs —
# keep the openrouter/ prefix, matching render.yaml and app/llm.py defaults)
NL2SQL_MODEL=openrouter/deepseek/deepseek-v4-flash-0731
NL2SQL_FAST_MODEL=openrouter/inclusionai/ling-3.0-flash

# Required: 32-byte hex string used for AES-256-GCM credential encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_32_byte_hex_string_here

# Optional: default Postgres DSN (used for integration tests)
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/testdb

# Optional: server-side DSN for the managed demo database. Never sent to
# clients — /api/demo/session only returns a connection_id that resolves here.
DEMO_DATABASE_URL=postgresql://testuser:testpass@localhost:5432/testdb

# Optional: when "false", POST /api/register is disabled (demo lockdown).
ALLOW_REGISTRATION=true

# ── Prerequisites ───────────────────────────────────────────────────────────
# Postgres (for integration tests):
#   docker run -d -p 5432:5432 \
#     -e POSTGRES_USER=testuser -e POSTGRES_PASSWORD=testpass \
#     -e POSTGRES_DB=testdb postgres:16