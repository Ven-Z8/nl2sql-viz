# NL2SQL Viz — Environment Variables
# Copy to .env and fill in real values

# Required: Anthropic API key for Claude (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Required: 32-byte hex string used for AES-256-GCM credential encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_32_byte_hex_string_here

# Optional: default Postgres DSN (used for integration tests)
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/testdb

# ── Prerequisites ───────────────────────────────────────────────────────────
# BUN runtime (for Code Exec Agent sandbox):
#   curl -fsSL https://bun.sh/install | bash
#   BUN is auto-added to ~/.zshrc — open a new terminal after install
#
# Postgres (for integration tests):
#   docker run -d -p 5432:5432 \
#     -e POSTGRES_USER=testuser -e POSTGRES_PASSWORD=testpass \
#     -e POSTGRES_DB=testdb postgres:16
